# Copy only after choosing your local database and generating your own secret.
# For the isolated local cluster, use: python -m scripts.phase3_db url --database dev
MAHJONG_DATABASE_URL=postgresql+psycopg://USER@127.0.0.1:5432/mahjong_phase3_dev
MAHJONG_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
MAHJONG_ENVIRONMENT=local
MAHJONG_COOKIE_SECURE=false
MAHJONG_HOST=127.0.0.1
MAHJONG_PORT=8000
MAHJONG_WORKERS=1
MAHJONG_MAX_ACTIVE_GAMES=128
MAHJONG_GAME_TTL_SECONDS=3600
MAHJONG_SESSION_TTL_SECONDS=86400
MAHJONG_MODEL_CHECKPOINT_PATH=artifacts/models/mahjong_discard_mlp_v3.pt
MAHJONG_MODEL_METADATA_PATH=artifacts/models/mahjong_discard_mlp_v3.metadata.json
MAHJONG_DATASET_CONTRACT_PATH=datasets/expanded_strict_v2/data_contract.json
MAHJONG_CONTACT_MEMBERS_PATH=config/contact_members.json
