          },
          "human_seat": {
            "type": "integer",
            "title": "Human Seat"
          },
          "prevalent_wind": {
            "type": "integer",
            "title": "Prevalent Wind"
          },
          "active_seat": {
            "type": "integer",
            "title": "Active Seat"
          },
          "turn_number": {
            "type": "integer",
            "title": "Turn Number"
          },
