            "title": "Fan Name En"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "fan_points",
          "count",
          "fan_name_zh",
          "fan_name_en"
        ],
        "title": "FanOut"
      },
      "GameCreate": {
        "properties": {
          "human_seat": {
            "type": "integer",
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Human Seat",
            "default": 0
          },
          "prevalent_wind": {
            "type": "integer",
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Prevalent Wind",
            "default": 0
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1.8446744073709552e+19,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          },
          "include_flowers": {
            "type": "boolean",
            "title": "Include Flowers",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "GameCreate"
      },
